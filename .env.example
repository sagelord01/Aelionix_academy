# ---------------------------------------------------------------------------
# Public app URL (used for auth redirects and canonical links)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — required for authentication and persistent learning data.
# Project Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for reading hidden tests, writing validated progress,
# and privileged account operations. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to "true" after enabling the Google provider in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ---------------------------------------------------------------------------
# AI tutoring provider: google (recommended free default), groq, or openai-compatible.
# ---------------------------------------------------------------------------
# Option 1: Google AI Studio (Free Tier / Fine-Tuned Gemini Models)
AI_PROVIDER=google
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash
# For a fine-tuned model created in Google AI Studio:
# GOOGLE_AI_MODEL=tunedModels/your-aelionix-tutor

# Option 2: Groq
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_REQUEST_TIMEOUT_MS=45000

# Option 3: Together AI / Ollama / Private Server (OpenAI-compatible)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://provider.example/v1
# AI_SUPPORTS_JSON_MODE=true

# ---------------------------------------------------------------------------
# Isolated code execution provider.
# Supported: judge0. Point this at Judge0 CE (hosted or self-hosted).
# Example hosted endpoint: https://judge0-ce.p.rapidapi.com
# ---------------------------------------------------------------------------
CODE_EXECUTION_PROVIDER=judge0
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=
# Some Judge0 deployments use X-RapidAPI-Key instead of X-Auth-Token.
CODE_EXECUTION_AUTH_HEADER=X-Auth-Token
CODE_EXECUTION_PYTHON_LANGUAGE_ID=71
CODE_EXECUTION_TIMEOUT_MS=20000
